int DNSPNM(int zbior[])                     //Dlugosc Najdluzszego Spojnego Podciagu Niemalejacego
{
    int maks_dlugosc=1, akt_dlugosc=1;

    for(int i = 1; i < ile; i++)
    {
        if(zbior[i] >= zbior[i-1])
        {
            akt_dlugosc++;
            maks_dlugosc = max(maks_dlugosc, akt_dlugosc);
        }
        else
        {
            akt_dlugosc = 1;
        }
    }
    return maks_dlugosc;
}

